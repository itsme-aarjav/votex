aws_region = "eu-north-1"

environment  = "production"
cluster_name = "votex-cluster"

cluster_version = "1.36"

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

node_instance_types = ["m7i-flex.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 2

# Configurable approved public CIDR allowlist for EKS API server (set to your workstation public IP CIDR, e.g. ["203.0.113.10/32"])
cluster_endpoint_public_access_cidrs = ["<OPERATOR_PUBLIC_IP>/32"]
